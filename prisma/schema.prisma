// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// 1. Tabel Admin (Pengelola Event)
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Akan di-hash
  name      String
  createdAt DateTime @default(now())
}

// 2. Tabel Utama Event
model Event {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique // Untuk URL ramah SEO (misal: /event/konser-musik)
  description     String   @db.Text
  bannerUrl       String?  // Link gambar banner dari Supabase Storage
  ticketDesignUrl String?  // Link gambar desain tiket
  eventDate       DateTime
  location        String
  isActive        Boolean  @default(true)
  artists         String[] // Daftar artis
  sponsors        String[] // Daftar sponsor
  whatsapp        String?  // Nomor WA Admin/Penyelenggara
  instagram       String?  // Username/Link Instagram
  bankAccounts    Json?    // Array rekening: [{ bank: string, number: string, name: string }]
  ticketConfig    Json?    // Custom design untuk tiket
  createdAt       DateTime @default(now())

  // Relasi
  fields           EventField[]
  transactions     Transaction[]
  ticketCategories TicketCategory[]
}

// 2.5 Tabel Kategori Tiket
model TicketCategory {
  id            String   @id @default(uuid())
  eventId       String
  name          String   // Misal: "VIP", "Regular"
  price         Int      // Harga tiket
  originalPrice Int?     // Harga Coret (Harga Asli sebelum diskon)
  quota         Int      // Batas kuota untuk kategori ini saat ini
  initialQuota  Int?     // Kuota saat pertama dibuat (untuk hitung % progress bar)

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
}

// 3. Tabel Custom Form (Pertanyaan Tambahan per Event)
// Contoh: Admin bikin pertanyaan "Ukuran Kaos" atau "Asal Instansi"
model EventField {
  id          String   @id @default(uuid())
  eventId     String
  name        String   // Nama pertanyaan (e.g., "Ukuran Kaos")
  type        FieldType // Enum: TEXT, SELECT, NUMBER
  options     String?  // JSON string untuk pilihan jika typenya SELECT (e.g., '["S", "M", "L", "XL"]')
  isRequired  Boolean  @default(true)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers     TicketAnswer[]
}

enum FieldType {
  TEXT
  NUMBER
  SELECT
  PHONE
  FILE
}

// 4. Tabel Transaksi Pembayaran (1 Transaksi bisa beli banyak tiket)
model Transaction {
  id              String    @id @default(uuid())
  eventId         String
  buyerName       String    // Nama perwakilan yang mentransfer
  buyerEmail      String
  buyerPhone      String    // Nomor WA perwakilan
  totalTickets    Int
  totalPrice      Int
  paymentProofUrl String?   // Link gambar bukti transfer (Supabase Storage)
  status          TxStatus  @default(PENDING)
  expiresAt       DateTime? // Batas waktu pembayaran (null = tidak ada batas)
  createdAt       DateTime  @default(now())

  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]
}

enum TxStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED   // Batas waktu pembayaran habis, kuota dikembalikan
}

// 5. Tabel Data Tiket Individu
model Ticket {
  id               String   @id @default(uuid())
  transactionId    String
  ticketCategoryId String
  barcodeString    String   @unique // String unik untuk digenerate jadi QR/Barcode
  isValidated      Boolean  @default(false)

  transaction      Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Restrict)
  answers          TicketAnswer[]
}

// 6. Tabel Jawaban dari Custom Form per Tiket
model TicketAnswer {
  id         String @id @default(uuid())
  ticketId   String
  fieldId    String
  value      String // Jawaban yang diisi peserta

  ticket Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field  EventField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

// 7. NextAuth.js Models untuk Google Login
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
